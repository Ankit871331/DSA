class Solution {
    public boolean uniqueOccurrences(int[] arr) {
        
        HashMap<Integer, Integer>map = new HashMap<>();

        for(int a: arr){
            map.put(a, map.getOrDefault(a, 0)+1);
        }

        for(int i: map.keySet()){
            
            for(int j: map.keySet()){
                if(i != j && map.get(i).equals(map.get(j))){
                    return false;
                }
            }
        }

        return true;
    }
}
