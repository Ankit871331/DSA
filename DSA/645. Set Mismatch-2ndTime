class Solution {
    public int[] findErrorNums(int[] nums) {
        int duplicate = 0;
        int missing = 0;
        HashSet<Integer> set = new HashSet<>();

        for(int num: nums){
            if(set.contains(num)){
                duplicate = num;
            }
            set.add(num);
        }

        for(int i = 1; i < nums.length+1; i++  ){
            if(!set.contains(i)){
                missing = i;
            }
        }

    return new int[]{duplicate, missing};
    }
}
